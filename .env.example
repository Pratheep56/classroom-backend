# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string (e.g. Neon / Supabase / local)
DATABASE_URL=

# Arcjet (https://arcjet.com) – shield, bot detection, rate limiting
ARCJET_KEY=
ARCJET_ENV=development

# Origin of the frontend, used for CORS and Better Auth trusted origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Random 32+ character string used to sign sessions (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Optional: real password-reset emails via https://resend.com. Leave empty to use the admin-issued
# reset links on the People page instead (works with no email provider).
RESEND_API_KEY=
MAIL_FROM=ClassFlow <onboarding@resend.dev>

# Set to "production" on Render: enables Secure / SameSite=None cookies and hides reset links from logs
NODE_ENV=development
